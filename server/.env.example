PORT=3011
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=superart_repair
# ตั้ง true เมื่อใช้ TiDB Cloud Serverless (บังคับ TLS) — เว้นว่างไว้ถ้าใช้ MySQL ธรรมดา
DB_SSL=
JWT_SECRET=change_this_secret
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# ไม่บังคับ — ใส่ครบ 3 ตัวนี้เมื่อไหร่ ระบบจะอัปโหลดรูปไป Cloudinary แทน disk
# (จำเป็นถ้า deploy บน host ที่ไม่มี persistent disk เช่น Render free/starter)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
